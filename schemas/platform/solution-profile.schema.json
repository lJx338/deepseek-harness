{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mfg-agent.dev/platform/solution-profile.schema.json",
  "title": "Manufacturing platform Solution Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.mfg-agent.dev/v1alpha1" },
    "kind": { "const": "SolutionProfile" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "customerId"],
      "properties": {
        "id": { "type": "string", "pattern": "^solution\\.[a-z0-9][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)+$" },
        "version": { "$ref": "#/$defs/version" },
        "customerId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "lockedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "version", "digest", "enabled"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 3 },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" },
        "enabled": { "type": "boolean" },
        "configurationRef": { "type": "string", "minLength": 1 }
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "sites", "deploymentTargets", "plugins", "mappings", "policies", "roleBindings", "features", "secretReferences", "migrations"],
      "properties": {
        "tenantId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "sites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "deploymentTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["center", "edge"] }
        },
        "plugins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lockedArtifact" } },
        "mappings": { "type": "array", "items": { "$ref": "#/$defs/contentReference" } },
        "policies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentReference" } },
        "roleBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "subjects"],
            "properties": {
              "role": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
              "subjects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "features": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*$" },
          "additionalProperties": { "type": "boolean" }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpuMillis": { "type": "integer", "minimum": 1 },
            "memoryMiB": { "type": "integer", "minimum": 1 },
            "storageMiB": { "type": "integer", "minimum": 1 }
          }
        },
        "secretReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^credential://[a-z0-9][a-z0-9/_-]*$" }
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "pluginId", "fromVersion", "toVersion", "rollback"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "pluginId": { "type": "string", "minLength": 3 },
              "fromVersion": { "$ref": "#/$defs/version" },
              "toVersion": { "$ref": "#/$defs/version" },
              "rollback": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

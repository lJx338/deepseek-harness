{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mfg-agent.dev/platform/plugin-manifest.schema.json",
  "title": "Manufacturing platform Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "platform.mfg-agent.dev/v1alpha1" },
    "kind": { "const": "Plugin" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(?:platform|mfg|customer\\.[a-z0-9][a-z0-9-]*)\\.[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/version" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "contractReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versionRange"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "versionRange": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean", "default": false },
        "unavailableBehavior": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "optional": { "const": true } }, "required": ["optional"] },
          "then": {
            "properties": { "unavailableBehavior": { "type": "string", "minLength": 1 } },
            "required": ["unavailableBehavior"]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime", "entry", "digest", "trust", "execution", "capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "runtime": { "enum": ["node", "web", "oci", "edge", "remote"] },
        "entry": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "trust": { "enum": ["first-party-trusted", "customer-trusted", "untrusted"] },
        "execution": { "enum": ["in-process", "isolated-process", "container", "remote"] },
        "signatureRef": { "type": "string", "minLength": 1 },
        "sbomRef": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }
        },
        "networkDestinations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fileRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "trust": { "const": "untrusted" } }, "required": ["trust"] },
          "then": {
            "properties": { "execution": { "enum": ["isolated-process", "container", "remote"] } }
          }
        }
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queries": { "$ref": "#/$defs/identifierList" },
        "actions": { "$ref": "#/$defs/identifierList" },
        "events": { "$ref": "#/$defs/identifierList" },
        "workflows": { "$ref": "#/$defs/identifierList" },
        "ui": { "$ref": "#/$defs/identifierList" }
      }
    },
    "identifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "platformVersionRange", "artifacts", "provides", "requires", "permissions", "contributions"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["contract", "provider", "connector", "domain", "agent", "workflow", "ui"] }
        },
        "platformVersionRange": { "type": "string", "minLength": 1 },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "provides": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contractReference" } },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contractReference" } },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" }
        },
        "contributions": { "$ref": "#/$defs/contributions" },
        "configurationSchemaRef": { "type": "string", "minLength": 1 },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "fromVersion", "toVersion", "rollback"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "fromVersion": { "$ref": "#/$defs/version" },
              "toVersion": { "$ref": "#/$defs/version" },
              "rollback": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
